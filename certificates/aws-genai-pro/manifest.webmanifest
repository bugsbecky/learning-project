{
  "id": "./",
  "name": "AIP-C01 Prep",
  "short_name": "AIP-C01",
  "description": "AWS Certified Generative AI Developer Professional exam prep. Study Maya's Company Knowledge Assistant, then run chapter quizzes and a mock exam.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mock exam",
      "short_name": "Exam",
      "description": "Full mock exam sorted by domain",
      "url": "./index.html#/exam",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Question bank",
      "short_name": "Bank",
      "description": "Browse all imported questions",
      "url": "./index.html#/bank",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
